<?xml version="1.0" encoding="utf-8"?>
<!-- Summary widget: a gradient card like the app's "today" card. Date and progress ring on top,
     four frosted status tiles, then the task to do next. The app paints the card (WidgetArt) into @id/bg. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hero_bg">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/date_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/date_wd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14.5sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/date_my"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/ring_box"
                android:layout_width="42dp"
                android:layout_height="42dp">

                <ProgressBar
                    android:id="@+id/ring"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/ring_progress" />

                <TextView
                    android:id="@+id/ring_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/glass_circle"
                android:padding="7dp"
                android:src="@drawable/ic_refresh"
                android:tint="#FFFFFFFF"
                android:contentDescription="@string/cd_refresh" />

            <ImageView
                android:id="@+id/btn_add"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/white_circle"
                android:padding="7dp"
                android:src="@drawable/ic_add"
                android:tint="@color/accent"
                android:contentDescription="@string/cd_add" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tile_overdue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/glass">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/dot_overdue" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginRight="5dp" android:src="@drawable/dot" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/num_overdue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:text="0" />
                </LinearLayout>
                <TextView android:id="@+id/label_overdue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:singleLine="true" android:ellipsize="end" android:textColor="#C7FFFFFF" android:textSize="10.5sp" android:text="@string/tile_overdue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_today"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/glass">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/dot_today" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginRight="5dp" android:src="@drawable/dot" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/num_today" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:text="0" />
                </LinearLayout>
                <TextView android:id="@+id/label_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:singleLine="true" android:ellipsize="end" android:textColor="#C7FFFFFF" android:textSize="10.5sp" android:text="@string/tile_today" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_doing"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/glass">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/dot_doing" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginRight="5dp" android:src="@drawable/dot" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/num_doing" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:text="0" />
                </LinearLayout>
                <TextView android:id="@+id/label_doing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:singleLine="true" android:ellipsize="end" android:textColor="#C7FFFFFF" android:textSize="10.5sp" android:text="@string/tile_doing" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_done"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/glass">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/dot_done" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginRight="5dp" android:src="@drawable/dot" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/num_done" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:text="0" />
                </LinearLayout>
                <TextView android:id="@+id/label_done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:singleLine="true" android:ellipsize="end" android:textColor="#C7FFFFFF" android:textSize="10.5sp" android:text="@string/tile_done" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/glass"
            android:paddingLeft="11dp"
            android:paddingTop="7dp"
            android:paddingRight="11dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/next_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/step_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/next_step"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="7"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/next_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="3"
                    android:layout_marginLeft="10dp"
                    android:minHeight="4dp"
                    android:maxHeight="4dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/glass_progress" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
