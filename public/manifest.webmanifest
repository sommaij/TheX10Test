{
  "name": "X10 Tasks",
  "short_name": "X10 Tasks",
  "description": "จัดการงานประจำวัน แจ้งเตือน ปฏิทิน และรับงานจาก API ของแอปอื่น",
  "lang": "th",
  "dir": "ltr",
  "id": "./",
  "start_url": "./#tasks",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#eef3f1",
  "theme_color": "#eef3f1",
  "categories": ["productivity"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "เพิ่มงาน", "short_name": "เพิ่มงาน", "url": "./?new=1#tasks", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "ปฏิทิน", "short_name": "ปฏิทิน", "url": "./#calendar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
